# Copy this file to `.env.local` and fill in personal cross-environment secrets.
# Then copy `.env.[NODE_ENV].example` → `.env.development.local` for dev DB / Stripe / etc.
# Ask a teammate for the values.

# Personal cross-env secrets (used in any NODE_ENV)
RESEND_API_KEY=
WORKER_SECRET=

# WhatsApp — clé 32 octets en hex (64 caractères) pour encrypter la session
# Baileys stockée dans la table `whatsapp_sessions`. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_ENCRYPTION_KEY=

# Web Push (notifications PWA) — paire de clés VAPID. Générer avec :
#   node -e "const c=require('crypto');const e=c.createECDH('prime256v1');e.generateKeys();const b=x=>x.toString('base64url');console.log('VAPID_PUBLIC_KEY='+b(e.getPublicKey()));console.log('VAPID_PRIVATE_KEY='+b(e.getPrivateKey()))"
# Recopier VAPID_PUBLIC_KEY à l'identique dans NEXT_PUBLIC_VAPID_PUBLIC_KEY (le
# navigateur en a besoin pour s'abonner). VAPID_SUBJECT = contact mailto:/URL.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@alertdeals.fr

# Stripe — test keys (sk_test_… / whsec_…) for local dev, live keys in prod
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# mytracks
MYTRACKS_API_KEY=

# CORS — origins du site vitrine autorisés à fetch /api/plans (séparés par virgule)
# dev : http://localhost:4321   |   prod : https://alertdeals.fr,https://www.alertdeals.fr
CORS_ALLOWED_ORIGINS=
# One Lobstr squid (scraper) per listing platform - the webhook's squid.id tells us the source
LOBSTR_SQUID_LEBONCOIN=
LOBSTR_SQUID_AUTOSCOUT24=
LOBSTR_SQUID_LACENTRALE=
LOBSTR_SQUID_PARUVENDU=
LOBSTR_API_KEY=

# ---- Auth ----
# "true" = self-signups must be validated by a super-admin before logging in
# (default off: accounts are auto-confirmed on first login)
ADMIN_VALIDATION_REQUIRED=false
